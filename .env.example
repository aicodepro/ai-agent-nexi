# ============================================================
# NEXI — Neural Executive Intelligence — Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# All settings have sensible defaults.
# ============================================================

# --- Identity ---
ASSISTANT_NAME=Nexi

# --- API Keys (Required) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Brain (Q&A LLM) ---
BRAIN_PROVIDER=gemini
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.35
GEMINI_MAX_OUTPUT_TOKENS=512

# --- ASR (Speech-to-Text) ---
ASR_PROVIDER=groq
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_ASR_LANGUAGE=en
GROQ_TIMEOUT_SECONDS=10

# --- TTS (Text-to-Speech) ---
TTS_PROVIDER_ORDER=groq,pyttsx3
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Fritz-PlayAI
GROQ_TTS_ENABLED=true
GROQ_TTS_TIMEOUT_SECONDS=10
TTS_SUMMARIZE_LONG_OUTPUT=true

# --- Wake Detection ---
VOICE_WAKE_BACKEND=openwakeword
NEXI_HOTWORD_ENABLED=true
NEXI_CLAP_ENABLED=true
NEXI_HOTKEY_WAKE_ENABLED=false
NEXI_WAKE_COOLDOWN_MS=1800

# --- Hotword (OpenWakeWord) ---
# Ships with a trained "hey nexi" model. To use a different wake word, retrain
# (training/train_hey_nexi.py) and point OPENWAKEWORD_MODEL_PATH at the .onnx.
# If the path is empty/missing, the loader falls back to a bundled model
# (OPENWAKEWORD_FALLBACK_MODEL, default hey_jarvis).
#
# SENSITIVITY: start at 0.30 / 1-hit for easy wake. Raise (e.g. 0.50 + 2 hits)
# only if you get false wakes. The code default is 0.35 / 3 hits (conservative).
OPENWAKEWORD_PHRASES=hey_nexi
OPENWAKEWORD_SCORE_THRESHOLD=0.30
OPENWAKEWORD_CONSECUTIVE_HITS=1
OPENWAKEWORD_MODEL_PATH=models/hey_nexi.onnx
HOTWORD_MIN_RMS=0.003
HOTWORD_RISING_EDGE_DELTA=0.02

# --- Wake Noise Rejection ---
# WAKE_REQUIRE_VOICE=false lets the hotword model alone decide when it hears
# "hey nexi" without a second Silero VAD gate. This vastly improves sensitivity
# in quiet rooms and at a distance. Only enable WAKE_REQUIRE_VOICE=true if you
# get false wakes from non-speech sounds (keyboard clatter, TV, fan).
WAKE_REQUIRE_VOICE=false
WAKE_MIN_RMS=0.015

# --- Clap Detection ---
# Backend priority (comma-separated): dsp_clap (no model) | clap_nn (trained CNN) | tzur | yamnet.
# DSP stays primary so startup never loads PyTorch just for clap detection. CLAP_NN is
# initialized only when selected as primary or when an earlier backend is unavailable.
NEXI_CLAP_BACKEND_ORDER=dsp_clap,clap_nn
# NEXI_CLAP_NN_MODEL_PATH=            # override the default model path if you keep the .pth elsewhere
NEXI_CLAP_MIN_GAP_MS=160
NEXI_CLAP_MAX_GAP_MS=4500
NEXI_DSP_CLAP_RMS_THRESHOLD=0.045
NEXI_DSP_CLAP_PEAK_THRESHOLD=0.14
NEXI_DSP_CLAP_PEAK_RATIO=5.2
NEXI_DSP_CLAP_HF_RATIO=0.43

# --- Audio / VAD ---
AUDIO_SAMPLE_RATE=16000
AUDIO_FRAME_MS=80
VAD_BACKEND=silero
VAD_THRESHOLD=0.5
VAD_SILENCE_END_MS=900
VAD_MIN_SPEECH_MS=300
VAD_PREROLL_MS=400
COMMAND_LISTEN_TIMEOUT_SECONDS=8

# --- Intent Routing ---
GROQ_INTENT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
INTENT_BRAIN_THRESHOLD=0.45
# Resource-safe default. Set to e5 only when semantic embeddings are worth the
# extra model memory; the embedder remains CPU-bound unless explicitly changed.
NEXI_ROUTER_EMBEDDER=hashing
NEXI_ROUTER_EMBEDDER_DEVICE=cpu

# --- OpenRouter: one key -> every model (idea #112) ---
# Lets NEXI switch to ANY model per task (Anthropic/OpenAI/Google/Meta + free models)
# instead of only the Groq-hosted set. Set the key, then point any task's model env at
# an OpenRouter id and the registry routes it there automatically (engine/model_registry
# .endpoint_for). Examples:
#   REACT_MODEL=anthropic/claude-sonnet-4.5      (code / tool reasoning)
#   VISION_MODEL=google/gemini-2.5-flash         (screen vision)
#   GROQ_INTENT_MODEL stays for fast local intent
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct   # default when provider=openrouter
# INTENT_ROUTER_PROVIDER=openrouter                     # route intent through OpenRouter
# OPENROUTER_SITE_URL / OPENROUTER_APP_TITLE are optional attribution only.

# --- Safety ---
SAFETY_GATE_ENABLED=true
SAFETY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- UI ---
NEXI_UI_MODE=mark
NEXI_FULLSCREEN=true
NEXI_WINDOW_MODE=fullscreen

# --- Follow-up ---
AUTO_LISTEN_AFTER_QUESTION=true
BARGE_IN_ENABLED=true

# --- Email (Optional) ---
NEXI_EMAIL_ADDRESS=
NEXI_EMAIL_PASSWORD=

# --- Nexi Agency Engine (autonomous workflow layer) ---
# false (default) = deterministic offline stubs. true = Gemini-backed passes + background execution.
NEXI_AGENCY_AUTONOMY=false
# Tool-risk policy: locked | manual | supervised | autonomous_safe
# supervised (default) = low-risk tools auto-run; write/medium/high/critical queue for approval.
NEXI_AGENCY_MODE=supervised
# Optional CrewAI backend for agency passes. Dormant unless set to "crewai" AND `pip install crewai`.
# Default (unset) keeps the clean-room engine.
NEXI_AGENCY_BACKEND=

# --- JARVIS-parity knobs ---
# Refuse to force-kill browsers (protects your Chrome tabs). Set 1 to allow it.
NEXI_ALLOW_BROWSER_KILL=
# Show console/PowerShell windows on subprocess spawns (default hidden on Windows). Set 1 to show.
NEXI_SHOW_TERMINALS=
# Screen-capture dedupe cooldown, ms. OFF by default (0) — NEXI already has an echo
# guard. Set >0 (e.g. 4000) to also skip rapid duplicate captures.
NEXI_VISION_COOLDOWN_MS=0
# Speak a top headline at startup once news loads (two-phase briefing). Set 1 to enable.
NEXI_STARTUP_BRIEFING=
# Optional: adds NewsAPI (direct publisher URLs) as a second racing news source.
NEWS_API_KEY=

# --- Face Recognition (startup auth gate — off in your setup) ---
# Master switch. false = skip the gate entirely (no camera, instant start).
FACE_RECOGNITION_ON_STARTUP=false
FACE_RECOGNITION_AUTH_GATE=true
FACE_RECOGNITION_USER_NAME=User
# LBPH confidence threshold: LOWER = stricter match (auth if confidence < threshold).
FACE_RECOGNITION_CONFIDENCE_THRESHOLD=60
FACE_RECOGNITION_CAMERA_INDEX=0
# Speed: use DirectShow on Windows (opens the camera far faster). Falls back if it fails.
FACE_RECOGNITION_DSHOW=true
# Calibration: discard N exposure-settling frames before matching (reliable first read).
FACE_RECOGNITION_WARMUP_FRAMES=5
# Calibration: require N consecutive matching frames to authenticate (1 = current behavior).
FACE_RECOGNITION_REQUIRED_MATCHES=1
# Safety: give up after N seconds instead of blocking startup forever (0 = wait forever).
FACE_RECOGNITION_TIMEOUT_S=0

# --- Nexi supervised agent runtime ---
# Supported built-ins: claude-code, opencode, hermes, openclaw, antigravity, custom-cli.
# Claude Code remains the compatibility default. Non-Claude providers require the
# generic opt-in below; Claude can still use NEXI_CLAUDE_CODE_ENABLED by itself.
NEXI_AGENT_RUNTIME_PROVIDER=claude-code
NEXI_AGENT_RUNTIME_ENABLED=
# Optional comma-separated child environment variable names required by your provider.
# Credentials are never put on command lines or written to run artifacts.
NEXI_AGENT_RUNTIME_ENV_ALLOWLIST=
NEXI_AGENT_RUNTIME_TIMEOUT_SECONDS=600
# Hard output bounds for supervised subprocesses.
NEXI_AGENT_RUNTIME_OUTPUT_CHARS=2000000
NEXI_AGENT_RUNTIME_LINE_CHARS=65536
NEXI_AGENT_RUNTIME_EVENT_CHARS=16000

# Claude Code adapter. OFF by default. Set 1 to enable the compatibility default.
NEXI_CLAUDE_CODE_ENABLED=
# Auto mode: acceptEdits (auto-accepts edits, won't silently run destructive shell
# cmds) | bypass (dangerously-skip-permissions: auto-accepts EVERYTHING incl. shell).
NEXI_CLAUDE_CODE_PERMISSION_MODE=acceptEdits
# Optional: explicit path to the claude binary if it's not on PATH.
CLAUDE_CLI_PATH=

# OpenCode adapter. Uses: opencode run --format json --dir <project>.
# Project config is disabled and a temporary isolated config is injected by Nexi.
OPENCODE_CLI_PATH=
# Optional explicit provider/model, recommended for deterministic isolated runs.
# Example verified in the disposable smoke test: google/gemini-2.5-flash
NEXI_OPENCODE_MODEL=

# Hermes Agent CLI adapter. Uses quiet automation mode in the target project cwd.
# This adapter has no proven native resume/event stream; Nexi reruns from evidence.
HERMES_CLI_PATH=

# OpenClaw CLI adapter. Configure an existing OpenClaw agent ID.
OPENCLAW_CLI_PATH=
NEXI_OPENCLAW_AGENT_ID=main
# OpenClaw can silently fall back from Gateway to embedded mode. Keep false unless
# that degraded transport is explicitly acceptable.
NEXI_OPENCLAW_ALLOW_EMBEDDED_FALLBACK=false

# Google Antigravity SDK adapter. Install separately with:
# .venv\Scripts\python.exe -m pip install google-antigravity
# Optional alternate Python executable containing the SDK:
ANTIGRAVITY_PYTHON_PATH=

# Generic no-shell adapter for another agentic CLI. The value must be a JSON argv
# array. Placeholders: {prompt}, {project_dir}, {control_cwd}, {session_id},
# {agent}, {owner_id}. Example:
# NEXI_CUSTOM_AGENT_COMMAND_JSON=["my-agent","run","--json","--cwd","{project_dir}","{prompt}"]
NEXI_CUSTOM_AGENT_COMMAND_JSON=
NEXI_CUSTOM_AGENT_CWD_MODE=control
# Custom capabilities default false. Enable only after adapter conformance tests prove them.
NEXI_CUSTOM_AGENT_STRUCTURED_EVENTS=false
NEXI_CUSTOM_AGENT_NATIVE_SESSIONS=false
NEXI_CUSTOM_AGENT_NATIVE_CANCEL=false
NEXI_CUSTOM_AGENT_ENFORCED_READ_ONLY=false
NEXI_CUSTOM_AGENT_ENFORCED_TOOL_POLICY=false

# Optional loopback workflow API. A bearer token is mandatory when it is started.
NEXI_AGENCY_API_TOKEN=

# --- Nexi Studio (supervised product team) ---
# OFF by default. Requires one enabled agent runtime above. Explicit triggers are:
# "let's build ...", "studio mode: ...", and "exotic mode: ...".
NEXI_STUDIO_ENABLED=false
# Required acknowledgement: generated code and tests run with this Windows account's
# filesystem permissions. Prefer a dedicated low-privilege account or VM/sandbox.
NEXI_STUDIO_ALLOW_HOST_EXECUTION=false
# New products are created here. Default: ~/Documents/Nexi Projects.
NEXI_STUDIO_PROJECTS_DIR=
# Optional additional roots for explicit project paths (semicolon-separated on Windows).
NEXI_STUDIO_ALLOWED_ROOTS=
# Approximate 500-token handoff budget per run artifact.
NEXI_STUDIO_DOC_CHAR_CAP=2000
# Questions, fix loops, stage agents, permission modes, branch policy, and extension
# allowlists are fail-closed in config/studio/governance.json. Named-agent stages use
# --strict-mcp-config and disable slash commands while the skills allowlist is empty.
# Exotic mode is an authorization alias and never enables bypassPermissions.
