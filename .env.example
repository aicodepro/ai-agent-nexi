# ============================================================
# NEXI — Neural Executive Intelligence — Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# All settings have sensible defaults.
# ============================================================

# --- Identity ---
ASSISTANT_NAME=Nexi

# --- API Keys (Required) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Brain (Q&A LLM) ---
BRAIN_PROVIDER=gemini
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.35
GEMINI_MAX_OUTPUT_TOKENS=512

# --- ASR (Speech-to-Text) ---
ASR_PROVIDER=groq
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_ASR_LANGUAGE=en
GROQ_TIMEOUT_SECONDS=10

# --- TTS (Text-to-Speech) ---
TTS_PROVIDER_ORDER=groq,pyttsx3
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Fritz-PlayAI
GROQ_TTS_ENABLED=true
GROQ_TTS_TIMEOUT_SECONDS=10
TTS_SUMMARIZE_LONG_OUTPUT=true

# --- Wake Detection ---
VOICE_WAKE_BACKEND=openwakeword
NEXI_HOTWORD_ENABLED=true
NEXI_CLAP_ENABLED=true
NEXI_HOTKEY_WAKE_ENABLED=false
NEXI_WAKE_COOLDOWN_MS=1800

# --- Hotword (OpenWakeWord) ---
# Ships with a trained "hey nexi" model. To use a different wake word, retrain
# (training/train_hey_nexi.py) and point OPENWAKEWORD_MODEL_PATH at the .onnx.
# If the path is empty/missing, the loader falls back to a bundled model
# (OPENWAKEWORD_FALLBACK_MODEL, default hey_jarvis).
OPENWAKEWORD_PHRASES=hey_nexi
OPENWAKEWORD_SCORE_THRESHOLD=0.65
OPENWAKEWORD_CONSECUTIVE_HITS=2
OPENWAKEWORD_MODEL_PATH=models/hey_nexi.onnx
HOTWORD_MIN_RMS=0.004
HOTWORD_RISING_EDGE_DELTA=0.03

# --- Clap Detection ---
# Backend priority (comma-separated): clap_nn (trained CNN) | dsp_clap (no model) | tzur | yamnet.
# clap_nn is used only once external/CLAP_NN/ASSETS/CLAP_DETECTS/MODELS/Clap_Detect_Model.pth
# exists (train it via scripts/record_clap_dataset.py + scripts/train_clap_nn.py). Until then the
# manager gracefully falls back to the next backend (dsp_clap, which needs no model).
NEXI_CLAP_BACKEND_ORDER=clap_nn,dsp_clap
# NEXI_CLAP_NN_MODEL_PATH=            # override the default model path if you keep the .pth elsewhere
NEXI_CLAP_MIN_GAP_MS=160
NEXI_CLAP_MAX_GAP_MS=950
NEXI_DSP_CLAP_RMS_THRESHOLD=0.045
NEXI_DSP_CLAP_PEAK_THRESHOLD=0.14
NEXI_DSP_CLAP_PEAK_RATIO_THRESHOLD=5.2
NEXI_DSP_CLAP_HF_RATIO_THRESHOLD=0.43

# --- Audio / VAD ---
AUDIO_SAMPLE_RATE=16000
AUDIO_FRAME_MS=80
VAD_BACKEND=silero
VAD_THRESHOLD=0.5
VAD_SILENCE_END_MS=900
VAD_MIN_SPEECH_MS=300
VAD_PREROLL_MS=400
COMMAND_LISTEN_TIMEOUT_SECONDS=8

# --- Intent Routing ---
GROQ_INTENT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
INTENT_BRAIN_THRESHOLD=0.45

# --- Safety ---
SAFETY_GATE_ENABLED=true
SAFETY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- UI ---
NEXI_UI_MODE=mark
NEXI_FULLSCREEN=true
NEXI_WINDOW_MODE=fullscreen

# --- Follow-up ---
AUTO_LISTEN_AFTER_QUESTION=true
BARGE_IN_ENABLED=true

# --- Email (Optional) ---
NEXI_EMAIL_ADDRESS=
NEXI_EMAIL_PASSWORD=

# --- Nexi Agency Engine (autonomous workflow layer) ---
# false (default) = deterministic offline stubs. true = Gemini-backed passes + background execution.
NEXI_AGENCY_AUTONOMY=false
# Tool-risk policy: locked | manual | supervised | autonomous_safe
# supervised (default) = low-risk tools auto-run; write/medium/high/critical queue for approval.
NEXI_AGENCY_MODE=supervised
# Optional CrewAI backend for agency passes. Dormant unless set to "crewai" AND `pip install crewai`.
# Default (unset) keeps the clean-room engine.
NEXI_AGENCY_BACKEND=

# --- JARVIS-parity knobs ---
# Refuse to force-kill browsers (protects your Chrome tabs). Set 1 to allow it.
NEXI_ALLOW_BROWSER_KILL=
# Show console/PowerShell windows on subprocess spawns (default hidden on Windows). Set 1 to show.
NEXI_SHOW_TERMINALS=
# Screen-capture dedupe cooldown, ms. OFF by default (0) — NEXI already has an echo
# guard. Set >0 (e.g. 4000) to also skip rapid duplicate captures.
NEXI_VISION_COOLDOWN_MS=0
# Speak a top headline at startup once news loads (two-phase briefing). Set 1 to enable.
NEXI_STARTUP_BRIEFING=
# Optional: adds NewsAPI (direct publisher URLs) as a second racing news source.
NEWS_API_KEY=
