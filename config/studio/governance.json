{
  "schema_version": 3,
  "artifact_root": "data/nexi/studio/runs/{run_id}",
  "max_questions_per_gate": 3,
  "max_fix_loops_per_gate": 3,
  "handoff_target_tokens": 500,
  "stages": {
    "requirements": {"gate": "G1", "ready_state": "REQUIREMENTS_READY", "agent": "business-analyst", "permission_mode": "plan", "read_only": true, "handoff_target": "research"},
    "research": {"gate": "G2", "ready_state": "RESEARCH_READY", "agent": "research-analyst", "permission_mode": "plan", "read_only": true, "handoff_target": "architecture"},
    "architecture": {"gate": "G3", "ready_state": "ARCHITECTURE_READY", "agent": "solution-architect", "permission_mode": "plan", "read_only": true, "handoff_target": "sprint_plan"},
    "sprint_plan": {"gate": "G4", "ready_state": "SPRINT_READY", "agent": "product-manager", "permission_mode": "plan", "read_only": true, "handoff_target": "implementation"},
    "implementation": {"gate": "G5", "ready_state": "IMPLEMENTATION_COMPLETE", "agent": "developer-team", "permission_mode": "acceptEdits", "read_only": false, "handoff_target": "developer_tests", "agent_bundle": ["developer-team", "frontend-engineer", "backend-engineer", "design-engineer", "test-engineer", "devops-engineer"]},
    "developer_tests": {"gate": "G6", "ready_state": "DEVELOPER_TESTS_PASS", "agent": "test-engineer", "permission_mode": "plan", "read_only": true, "handoff_target": "qa", "failure_handoff": "developer-team"},
    "qa": {"gate": "G7", "ready_state": "QA_PASS", "agent": "qa-verifier", "permission_mode": "plan", "read_only": true, "handoff_target": "security_review", "failure_handoff": "developer-team"},
    "security_review": {"gate": "G8", "ready_state": "SECURITY_PASS", "agent": "security-reviewer", "permission_mode": "plan", "read_only": true, "handoff_target": "integration", "failure_handoff": "developer-team"},
    "integration": {"gate": "G9", "ready_state": "INTEGRATION_PASS", "agent": "integration-verifier", "permission_mode": "plan", "read_only": true, "handoff_target": "release", "failure_handoff": "developer-team"},
    "release": {"gate": "G10", "ready_state": "LOCAL_VERIFIED", "agent": "release-manager", "permission_mode": "plan", "read_only": true, "handoff_target": "closeout"},
    "closeout": {"gate": "G11", "ready_state": "CLOSED", "agent": "knowledge-curator", "permission_mode": "plan", "read_only": true, "handoff_target": "closed"}
  },
  "request_class_stage_plans": {
    "NEW_PROJECT": ["requirements", "research", "architecture", "sprint_plan", "implementation", "developer_tests", "qa", "security_review", "integration", "release", "closeout"],
    "IDEA_REVISION": ["requirements", "research", "architecture", "sprint_plan", "implementation", "developer_tests", "qa", "security_review", "integration", "release", "closeout"],
    "FEATURE_CHANGE": ["requirements", "architecture", "sprint_plan", "implementation", "developer_tests", "qa", "security_review", "integration", "release", "closeout"],
    "CHANGE_REQUEST": ["requirements", "sprint_plan", "implementation", "developer_tests", "qa", "security_review", "integration", "release", "closeout"],
    "BUG_FIX": ["requirements", "sprint_plan", "implementation", "developer_tests", "qa", "security_review", "integration", "release", "closeout"],
    "TECHNICAL_IMPROVEMENT": ["requirements", "architecture", "sprint_plan", "implementation", "developer_tests", "qa", "security_review", "integration", "release", "closeout"],
    "EXPERIMENT": ["requirements", "research", "architecture", "sprint_plan", "implementation", "developer_tests", "qa", "security_review", "integration", "release", "closeout"],
    "RELEASE": ["requirements", "sprint_plan", "developer_tests", "qa", "security_review", "integration", "release", "closeout"],
    "HOTFIX": ["requirements", "sprint_plan", "implementation", "developer_tests", "qa", "security_review", "integration", "release", "closeout"],
    "CONTINUATION": ["requirements", "sprint_plan", "implementation", "developer_tests", "qa", "security_review", "integration", "release", "closeout"]
  },
  "extension_allowlists": {"skills": [], "mcp_servers": [], "plugins": []},
  "branch_policy": {
    "protected_branches": ["main", "master", "development"],
    "implementation_on_protected_branch": "block",
    "require_same_repository_on_resume": true,
    "require_same_branch_on_resume": true,
    "require_same_head_on_resume": true
  },
  "release": {
    "enabled": false,
    "configuration_complete": false,
    "reviewer_identities": [],
    "pull_request_integration": false,
    "ci_integration": false
  },
  "deployment": {
    "enabled": false,
    "configuration_complete": false,
    "reviewer_identities": [],
    "environments": []
  },
