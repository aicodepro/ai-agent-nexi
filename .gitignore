# ============================================================
# NEXI — Python voice assistant (.gitignore)
# ============================================================

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Node / eel web UI ---
node_modules/

# --- Runtime data (keep the folder, drop its contents) ---
data/*
!data/.gitkeep
data/memory/

# --- Wake-word training artifacts ---
# Generated clips & features (safe to delete; regenerated by training)
training/_work/
# Trained wake model output
models/
*.onnx
# Large downloaded TTS/voice models
*.pt
*.pth
*.ckpt
*.tflite

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
Thumbs.db
.DS_Store

# --- Temp / logs ---
*.tmp
*.log
