# ============================================================
# NEXI — Python voice assistant (.gitignore)
# ============================================================

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- MCP config (may embed server paths / tokens) ---
.mcp.json
*.mcp.json

# --- OpenCode framework files ---
.opencode/
.opencode.json
.opencode.jsonc

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments / secrets ---
# Anchored to the repo root and NOT a bare `env*` glob: `env*` also matched
# engine/**/environment.py and silently excluded real source from the repo,
# so a fresh clone was missing modules the runtime imports.
venv/
.venv/
/env
/env/
/.env
/.env.*
/env.*

# --- Node / eel web UI ---
node_modules/

# --- Runtime data (keep the folder, drop its contents) ---
data/*
!data/.gitkeep
data/memory/

# --- Wake-word training artifacts ---
# Generated clips & features (safe to delete; regenerated by training)
training/_work/
# Trained wake model output
models/*
*.onnx
# Ship the trained wake model so "hey nexi" works on a fresh clone
!models/hey_nexi.onnx
# Large downloaded TTS/voice models
*.pt
*.pth
*.ckpt
*.tflite

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
Thumbs.db
.DS_Store

# --- Temp / logs ---
*.tmp
*.log

# Machine-specific MCP config (absolute paths). Copy .mcp.json.example -> .mcp.json
.mcp.json
.mcp.json.bak-*
